PORT=3001
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001

# Frontend Production API URL (Used by Vite when frontend is deployed separately e.g. on Vercel/Netlify)
# VITE_API_URL=https://codelens-api.onrender.com

# MongoDB Atlas / Local Persistence
# Set to your MongoDB Atlas connection string for production persistence:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codelens?retryWrites=true&w=majority
# MONGODB_URI=mongodb://127.0.0.1:27017/codelens

# JWT and Session Signing (Required: 32+ cryptographically random characters)
JWT_SECRET=replace-this-with-a-long-random-secret-before-deploying

# Email Infrastructure (CodeLens Notification Service)
# Default sender address:
EMAIL_FROM=CodeLens <codelens044@gmail.com>

# For Gmail SMTP delivery with App Password:
# GMAIL_APP_PASSWORD=abcd-efgh-ijkl-mnop
# SMTP_USER=codelens044@gmail.com
# SMTP_PASS=abcd-efgh-ijkl-mnop
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
OTP_EXPIRY_MINUTES=10

# Or custom SMTP provider (Resend, SendGrid, Amazon SES, Postmark):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-api-key

# OAuth 2.0 / OIDC Authentication Providers
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback (or https://your-domain.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# GitHub Developer Applications: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3001/api/auth/github/callback (or https://your-domain.com/api/auth/github/callback)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# LinkedIn Developer Portal: https://www.linkedin.com/developers/apps
# Authorized redirect URL: http://localhost:3001/api/auth/linkedin/callback (or https://your-domain.com/api/auth/linkedin/callback)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_CALLBACK_URL=http://localhost:3001/api/auth/linkedin/callback

# Billing & Stripe (Optional)
DEMO_BILLING=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# STRIPE_PRO_YEARLY_PRICE_ID=price_...

# Production Environment flag
# NODE_ENV=production

# Multi-Language Judge0 Execution Engine (Optional)
# JUDGE0_URL=https://your-judge0-host.example/
# JUDGE0_API_KEY=
# JUDGE0_AUTH_HEADER=X-RapidAPI-Key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
